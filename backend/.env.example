DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_strategy_os?schema=public"
# Optional: a direct (non-pooled) connection string, used only by the Prisma
# CLI (migrate/introspect). Falls back to DATABASE_URL if unset. Needed when
# DATABASE_URL points at a connection pooler (e.g. Supabase's pooler on 6543
# or its "Session pooler"), since DDL/advisory locks don't work well through it.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/crm_strategy_os?schema=public"
