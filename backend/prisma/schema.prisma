generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CardType {
  cluster
  pipeline
  funil
  cliente
  campanha
  anuncio
  mensagem
  template
  produto
  categoria
  objetivo
  rfv
  segmentacao
  acao
  condicao
  espera
  decisao
  observacao
  documento
  indicador
  kpi
  metrica
  api
  integracao
  banco_de_dados
  webhook
  cupom
  promocao
  loja
  fornecedor
  marca
  persona
  jornada
  automacao
  workflow
  evento
}

enum CardStatus {
  planejamento
  criado
  em_andamento
  em_teste
  ativo
  pausado
  concluido
  arquivado
}

enum CardPriority {
  baixa
  media
  alta
  urgente
}

model Workspace {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id           String       @id @default(cuid())
  name         String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId  String
  // When set, this project is the dedicated "page" for a single card
  // (drill-down navigation), rather than a top-level project.
  parentCard   Card?        @relation("CardChildProject", fields: [parentCardId], references: [id], onDelete: Cascade)
  parentCardId String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  cards        Card[]       @relation("ProjectCards")
  connections  Connection[]
}

model Card {
  id            String       @id @default(cuid())
  project       Project      @relation("ProjectCards", fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  type          CardType
  name          String
  description   String?
  color         String?
  category      String?
  responsavel   String?
  status        CardStatus?
  priority      CardPriority?
  tags          String[]     @default([])
  dueDate       DateTime?
  expectedValue String?
  roi           String?
  investimento  String?
  ticketMedio   String?
  conversao     String?
  notes         String?
  positionX     Float        @default(0)
  positionY     Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  comments      Comment[]

  // The dedicated sub-page/canvas "inside" this card, if one has been opened.
  childProject Project? @relation("CardChildProject")

  connectionsFrom Connection[] @relation("ConnectionSource")
  connectionsTo   Connection[] @relation("ConnectionTarget")

  @@index([projectId])
}

model Connection {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  source    Card     @relation("ConnectionSource", fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId  String
  target    Card     @relation("ConnectionTarget", fields: [targetId], references: [id], onDelete: Cascade)
  targetId  String
  label     String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Comment {
  id        String   @id @default(cuid())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  author    String
  body      String
  createdAt DateTime @default(now())

  @@index([cardId])
}
